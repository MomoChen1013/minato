---
// 全站頁首導覽。active 傳 'blog' 時，部落格連結會高亮。
interface Props { active?: 'blog' }
const { active } = Astro.props;
---
<header id="hd">
  <a class="logo" href="/index.html">
    <svg width="38" height="38" viewBox="0 0 48 48" aria-hidden="true">
      <circle cx="24" cy="24" r="21.5" fill="none" stroke="#1C2B36" stroke-width="2.4"/>
      <g stroke="#1C2B36" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M26 31 L27.5 15.5 L33.5 15.5 L35 31"/>
        <path d="M26.6 20.5 L34.4 20.5 M26.2 25.5 L34.8 25.5"/>
        <path d="M28.5 15.5 L28.5 11.5 L32.5 11.5 L32.5 15.5"/>
        <path d="M10 34 Q15 31 20 34 T30 34 T40 34" stroke-width="2"/>
        <path d="M12 27.5 Q14.5 23 17.5 27.5 Z" fill="#1C2B36" stroke="none"/>
        <path d="M11 29.5 L18.8 29.5" stroke-width="2"/>
      </g>
      <g stroke="#FFC93C" stroke-width="2.2" stroke-linecap="round">
        <path d="M27 9 L24 6.2 M30.5 8 L30.5 4.4 M34 9 L37 6.2" fill="none"/>
        <circle cx="30.5" cy="13.5" r="1.4" fill="#FFC93C" stroke="none"/>
      </g>
    </svg>
    <span class="nm">小港製作所<small>MINATO STUDIO — CROSS-BORDER DESIGN</small></span>
  </a>
  <nav>
    <a href="/index.html#services">服務內容</a>
    <a href="/index.html#works">實戰案例</a>
    <a href="/blog/" class={active === 'blog' ? 'on' : undefined}>部落格</a>
    <a class="cta" href="/index.html#inquiry">諮詢洽談 →</a>
  </nav>
</header>

<script>
  const hd = document.getElementById('hd');
  addEventListener('scroll', () => hd?.classList.toggle('scrolled', scrollY > 40), { passive: true });
</script>
