---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, CATEGORIES } from '../consts';
import '../styles/global.css';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  readingTime: string;
  related: CollectionEntry<'blog'>[];
}
const { post, headings, readingTime, related } = Astro.props;
const d = post.data;
const slug = post.id;
const path = `/blog/${slug}/`;
const cat = CATEGORIES[d.category];

// 目次只取 h2（文章主段落）
const toc = headings.filter((h) => h.depth === 2);

const published = d.date;
const modified = d.updated ?? d.date;
const fmtZh = (x: Date) =>
  `${x.getUTCFullYear()} 年 ${x.getUTCMonth() + 1} 月 ${x.getUTCDate()} 日`;
const iso = (x: Date) => x.toISOString();
const site = Astro.site!;
const coverUrl = d.cover ? new URL(d.cover, site).href : undefined;

// ── JSON-LD（BlogPosting + BreadcrumbList + FAQPage） ──
const graph: any[] = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    ...(coverUrl ? { image: coverUrl } : {}),
    datePublished: iso(published),
    dateModified: iso(modified),
    inLanguage: 'zh-Hant',
    articleSection: cat.zh,
    ...(d.keywords.length ? { keywords: d.keywords.join(', ') } : {}),
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(path, site).href },
    author: { '@type': 'Organization', name: SITE.name, url: `${site.origin}/` },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      logo: { '@type': 'ImageObject', url: new URL(SITE.logoPath, site).href },
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: `${site.origin}/` },
      { '@type': 'ListItem', position: 2, name: '部落格', item: new URL('/blog/', site).href },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
if (d.faq.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <BaseHead
    title={`${d.title}｜${SITE.name}`}
    description={d.description}
    path={path}
    type="article"
    image={d.cover ?? SITE.ogFallback}
    keywords={d.keywords}
    publishedTime={iso(published)}
    modifiedTime={iso(modified)}
    section={cat.zh}
  />
  <script type="application/ld+json" set:html={jsonld} />
</head>
<body>

<div class="progress" id="prog"></div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <filter id="pencil" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="7" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5"/>
  </filter>
</defs></svg>

<SiteHeader active="blog" />

<main>
<article>

  <!-- hero -->
  <section class="a-hero">
    <svg class="deco deco-ahero" viewBox="0 0 180 110" aria-hidden="true">
      <path d="M20 40 Q30 30 40 40 M40 40 Q50 30 60 40"/>
      <path d="M96 24 Q104 16 112 24 M112 24 Q120 16 128 24" opacity=".7"/>
      <circle cx="150" cy="66" r="3" class="amb"/>
      <path d="M10 92 Q34 82 58 92 T106 92 T160 92" opacity=".5"/>
    </svg>
    <div class="wrap">
      <nav class="crumb" aria-label="breadcrumb">
        <a href="/index.html">首頁</a><span class="sep">/</span>
        <a href="/blog/">部落格</a><span class="sep">/</span>
        <span>{d.title}</span>
      </nav>

      <span class="a-cat">{cat.en}</span>
      <h1 set:html={d.titleHtml ?? d.title} />

      <div class="a-meta">
        <span class="who"><span class="av">港</span>{SITE.name}</span>
        <span class="dot"></span>
        <time datetime={published.toISOString().slice(0, 10)}>{fmtZh(published)}</time>
        <span class="dot"></span>
        <span>閱讀約 {readingTime}</span>
        <span class="dot"></span>
        <span>{cat.zh}</span>
      </div>

      <div class="lead-strip" role="img" aria-label={d.coverAlt ?? d.title}>
        {coverUrl ? <img src={coverUrl} alt={d.coverAlt ?? d.title} width="1200" height="630" /> : '主視覺圖片（在 frontmatter 加 cover 即可換成圖片）'}
      </div>
    </div>
  </section>

  <!-- body -->
  <div class="a-body-wrap">
    <div class="wrap a-grid">

      {toc.length > 0 && (
        <aside class="toc" aria-label="目次">
          <div class="tt">目次 Contents</div>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </aside>
      )}

      <div class="article-body">

        {d.tldr.length > 0 && (
          <div class="tldr">
            <div class="tt">重點摘要 TL;DR</div>
            <ul>
              {d.tldr.map((t) => <li set:html={t} />)}
            </ul>
          </div>
        )}

        {d.lead && <p class="lead" set:html={d.lead} />}

        <slot />

        {d.faq.length > 0 && (
          <>
            <h2 id="faq">常見問題</h2>
            <div class="faq">
              {d.faq.map((f) => (
                <details>
                  <summary>{f.q}<span class="ic">＋</span></summary>
                  <p set:html={f.a} />
                </details>
              ))}
            </div>
          </>
        )}

        <div class="author-box">
          <div class="av">港</div>
          <div class="info">
            <div class="nm">小港製作所 Minato Studio<small>CROSS-BORDER DESIGN STUDIO ・ 台北 ⇄ 札幌</small></div>
            <p class="bio">小港製作所是專注台日跨境的設計工作室，服務範圍涵蓋品牌識別、多語系網站與產品 UX 在地化。我們以中・日・英三語進行內容轉譯，從市場定位、資訊架構到上線，提供一條龍的整合交付。相信好的設計始於「先把你的故事聽懂」——不只是把字翻對，而是讓品牌在當地被正確地理解與信任。</p>
            <div class="cred">
              <span class="chip">台日跨境在地化</span>
              <span class="chip">多語系網站設計</span>
              <span class="chip">中・日・英三語轉譯</span>
              <span class="chip">台北 ⇄ 札幌</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- related -->
  <section class="related">
    <svg class="deco deco-rel" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-20 95 Q70 80 160 95 T340 95 T520 95 T700 95 T880 95 T1060 95 T1240 95 T1460 95" opacity=".8"/>
      <path d="M-20 120 Q80 106 180 120 T380 120 T580 120 T780 120 T980 120 T1180 120 T1460 120" opacity=".45"/>
    </svg>
    <div class="wrap">
      <span class="sec-label">Read next</span>
      <h2 class="reveal">接著看這幾篇</h2>
      {related.length > 0 && (
        <div class="rel-grid">
          {related.map((r, i) => (
            <a class="rel-card reveal" style={`transition-delay:${i * 0.08}s`} href={`/blog/${r.id}/`}>
              <span class="rc-cat">{CATEGORIES[r.data.category].en}</span>
              <h3>{r.data.title}</h3>
              <p>{r.data.description}</p>
              <span class="go">閱讀 →</span>
            </a>
          ))}
        </div>
      )}
      <div class="rel-more reveal">
        <a href="/blog/">瀏覽所有文章 →</a>
      </div>
    </div>
  </section>

  <!-- end CTA -->
  <section class="end-cta">
    <svg class="deco deco-endcta" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-20 95 Q70 80 160 95 T340 95 T520 95 T700 95 T880 95 T1060 95 T1240 95 T1460 95" opacity=".8"/>
      <path d="M-20 120 Q80 106 180 120 T380 120 T580 120 T780 120 T980 120 T1180 120 T1460 120" opacity=".45"/>
      <g transform="translate(300,40)" class="amb" opacity=".9"><path d="M0 30 Q4 40 15 40 L48 40 Q58 40 62 30 Z"/><path d="M28 30 L28 4 M28 7 Q48 10 48 24 L28 26"/></g>
    </svg>
    <div class="wrap">
      <div class="mini">聊聊<br>吧。</div>
      <h2>想進日本，<span class="rd">卻不確定哪裡卡住</span>？</h2>
      <p>先從一場免費的 20 分鐘對談開始。想到哪、說到哪就好，我們會在兩個工作天內回覆。</p>
      <a class="btn" href="/index.html#inquiry">預約免費對談 <span class="ar">→</span></a>
    </div>
  </section>

</article>
</main>

<SiteFooter en="DESIGN IS A LANGUAGE. WE SPEAK THREE." />

<script>
  // reading progress
  const prog = document.getElementById('prog');
  addEventListener('scroll', () => {
    const h = document.documentElement;
    if (prog) prog.style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100 + '%';
  }, { passive: true });

  // reveal
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // TOC active highlight
  const links = [...document.querySelectorAll('.toc a')];
  const spy = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (e.isIntersecting) {
        const id = (e.target as HTMLElement).id;
        links.forEach((l) => l.classList.toggle('active', l.getAttribute('href') === '#' + id));
      }
    });
  }, { rootMargin: '-20% 0px -70% 0px' });
  document.querySelectorAll('.article-body h2[id]').forEach((h) => spy.observe(h));
</script>
</body>
</html>
