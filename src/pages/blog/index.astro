---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE, CATEGORIES } from '../../consts';
import '../../styles/global.css';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date);

const site = Astro.site!;
const fmt = (x: Date) =>
  `${x.getUTCFullYear()}.${String(x.getUTCMonth() + 1).padStart(2, '0')}.${String(x.getUTCDate()).padStart(2, '0')}`;
const readMin = (p: (typeof posts)[number]) =>
  p.data.readingTime ?? `${Math.max(1, Math.round((p.body?.replace(/\s/g, '').length ?? 0) / 450))} 分鐘`;

// 分類篩選鈕（只顯示實際有文章的分類 + 全部）
const usedCats = [...new Set(posts.map((p) => p.data.category))];

// JSON-LD：Blog + BreadcrumbList
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      name: `${SITE.name} 部落格`,
      description: '台日跨境設計、多語系網站與品牌在地化的實戰筆記。',
      url: new URL('/blog/', site).href,
      inLanguage: 'zh-Hant',
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        logo: { '@type': 'ImageObject', url: new URL(SITE.logoPath, site).href },
      },
      blogPost: posts.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        url: new URL(`/blog/${p.id}/`, site).href,
        datePublished: p.data.date.toISOString(),
        dateModified: (p.data.updated ?? p.data.date).toISOString(),
        author: { '@type': 'Organization', name: SITE.name },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: `${site.origin}/` },
        { '@type': 'ListItem', position: 2, name: '部落格', item: new URL('/blog/', site).href },
      ],
    },
  ],
});
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <BaseHead
    title={`部落格｜台日跨境設計與在地化筆記｜${SITE.name}`}
    description="小港製作所的跨境筆記：把台日市場、多語系網站、品牌在地化與 UX 設計的實戰經驗，整理成可以照著做的文章。從進軍日本前的準備，到上線後的細節優化。"
    path="/blog/"
    type="website"
    keywords={['台日跨境設計', '日文網站', '在地化', '多語系網站', '品牌進軍日本', '部落格']}
  />
  <script type="application/ld+json" set:html={jsonld} />
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <filter id="pencil" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="7" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5"/>
  </filter>
</defs></svg>

<SiteHeader active="blog" />

<main>

  <section class="l-hero">
    <svg class="deco deco-lhero" viewBox="0 0 180 110" aria-hidden="true">
      <path d="M20 40 Q30 30 40 40 M40 40 Q50 30 60 40"/>
      <path d="M96 24 Q104 16 112 24 M112 24 Q120 16 128 24" opacity=".7"/>
      <circle cx="150" cy="66" r="3" class="amb"/>
      <path d="M10 92 Q34 82 58 92 T106 92 T160 92" opacity=".5"/>
    </svg>
    <div class="wrap">
      <nav class="crumb" aria-label="breadcrumb">
        <a href="/index.html">首頁</a><span class="sep">/</span>
        <span>部落格</span>
      </nav>
      <span class="l-eyebrow">Cross-border Journal</span>
      <h1>跨境的路上，<span class="hl">我們把踩過的坑寫下來</span>。</h1>
      <p class="sub">台日市場、多語系網站、品牌在地化與 UX 設計——把實戰現場的觀察，整理成可以照著做的筆記。給正準備出海、或已經在海上的你。</p>

      <div class="filters" role="tablist" aria-label="文章分類篩選">
        <button class="on" data-cat="all" aria-pressed="true">全部</button>
        {usedCats.map((c) => (
          <button data-cat={c} aria-pressed="false">{CATEGORIES[c].zh}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="l-body">
    <div class="wrap">
      <div class="grid" id="grid">
        {posts.map((p, i) => (
          <a class="card reveal" href={`/blog/${p.id}/`} data-cat={p.data.category}>
            <span class={`thumb${i % 3 === 1 ? ' c2' : i % 3 === 2 ? ' c3' : ''}`}>
              {p.data.cover && <img src={new URL(p.data.cover, site).href} alt={p.data.coverAlt ?? p.data.title} />}
              <span class="rc-cat">{CATEGORIES[p.data.category].en}</span>
            </span>
            <span class="body">
              <span class="meta"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time><span class="dot"></span><span>{readMin(p)}</span></span>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="go">閱讀文章 →</span>
            </span>
          </a>
        ))}
      </div>
      {posts.length === 0 && <p style="text-align:center;color:var(--ink-soft);padding:60px 0;">文章正在醞釀中，很快就來。</p>}
      <p class="empty" id="empty">這個分類目前還在醞釀中，先看看其他文章吧。</p>
    </div>
  </section>

  <section class="end-cta dark">
    <svg class="deco deco-endcta" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-20 95 Q70 80 160 95 T340 95 T520 95 T700 95 T880 95 T1060 95 T1240 95 T1460 95" opacity=".8"/>
      <path d="M-20 120 Q80 106 180 120 T380 120 T580 120 T780 120 T980 120 T1180 120 T1460 120" opacity=".45"/>
    </svg>
    <div class="wrap">
      <div class="mini">聊聊<br>吧。</div>
      <h2>有想問的，<span class="rd">不用等文章寫完</span>。</h2>
      <p>正準備進日本、或卡在某個環節？先從一場免費的 20 分鐘對談開始，我們會在兩個工作天內回覆。</p>
      <a class="btn" href="/index.html#inquiry">預約免費對談 <span class="ar">→</span></a>
    </div>
  </section>

</main>

<SiteFooter />

<script>
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  const btns = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
  const cards = [...document.querySelectorAll<HTMLElement>('#grid .card')];
  const empty = document.getElementById('empty');
  btns.forEach((b) => b.addEventListener('click', () => {
    const cat = b.dataset.cat;
    btns.forEach((x) => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
    let shown = 0;
    cards.forEach((c) => { const hit = cat === 'all' || c.dataset.cat === cat; c.style.display = hit ? '' : 'none'; if (hit) shown++; });
    if (empty) empty.style.display = shown ? 'none' : 'block';
  }));
</script>
</body>
</html>
